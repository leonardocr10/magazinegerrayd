generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  INACTIVE
  PENDING
}

enum ProductStatus {
  DRAFT
  ACTIVE
  INACTIVE
  OUT_OF_STOCK
  ARCHIVED
}

enum BannerPosition {
  HOME_HERO
  HOME_SECONDARY
  CATEGORY_TOP
  SEARCH_TOP
  SIDEBAR
}

enum SyncJobStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
  PARTIAL
}

enum ImportJobStatus {
  PENDING
  PREVIEW
  CONFIRMED
  COMPLETED
  FAILED
}

enum IntegrationLogLevel {
  INFO
  WARNING
  ERROR
}

enum CouponStatus {
  ACTIVE
  EXPIRED
  INACTIVE
}

model User {
  id                  String        @id @default(cuid())
  name                String?
  email               String        @unique
  passwordHash        String?
  emailVerifiedAt     DateTime?
  googleId            String?       @unique
  status              UserStatus    @default(PENDING)
  acceptedTermsAt     DateTime?
  acceptedPrivacyAt   DateTime?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  favorites           Favorite[]
  priceAlerts         PriceAlert[]
  clicks              Click[]
  searchLogs          SearchLog[]
}

model AdminUser {
  id              String   @id @default(cuid())
  name            String
  email           String   @unique
  passwordHash    String
  isSuperAdmin    Boolean  @default(false)
  status          UserStatus @default(ACTIVE)
  lastLoginAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  roles           AdminUserRole[]
  importJobs      ImportJob[]
  syncJobs        SyncJob[]
}

model Role {
  id              String   @id @default(cuid())
  name            String   @unique
  slug            String   @unique
  description     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  permissions     RolePermission[]
  adminUsers      AdminUserRole[]
}

model Permission {
  id              String   @id @default(cuid())
  name            String   @unique
  slug            String   @unique
  description     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  roles           RolePermission[]
}

model AdminUserRole {
  adminUserId     String
  roleId          String
  assignedAt      DateTime @default(now())
  adminUser       AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  role            Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([adminUserId, roleId])
}

model RolePermission {
  roleId          String
  permissionId    String
  assignedAt      DateTime @default(now())
  role            Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission      Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model Marketplace {
  id                    String                  @id @default(cuid())
  name                  String                  @unique
  slug                  String                  @unique
  logoUrl               String?
  baseUrl               String
  affiliateIdentifier   String?
  integrationStatus     String                  @default("CONFIGURACAO_PENDENTE")
  lastSyncedAt          DateTime?
  syncIntervalMinutes   Int                     @default(120)
  estimatedCommission   Decimal?                @db.Decimal(5, 2)
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  credentials           MarketplaceCredential[]
  products              Product[]
  offers                ProductOffer[]
  coupons               Coupon[]
  clicks                Click[]
  importJobs            ImportJob[]
  syncJobs              SyncJob[]
  integrationLogs       IntegrationLog[]
}

model MarketplaceCredential {
  id                String      @id @default(cuid())
  marketplaceId     String
  label             String
  encryptedValue    String
  metadata          Json?
  active            Boolean     @default(true)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  marketplace       Marketplace @relation(fields: [marketplaceId], references: [id], onDelete: Cascade)
}

model Category {
  id                String      @id @default(cuid())
  parentId          String?
  name              String
  slug              String      @unique
  icon              String?
  imageUrl          String?
  sortOrder         Int         @default(0)
  active            Boolean     @default(true)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  parent            Category?   @relation("CategoryToCategory", fields: [parentId], references: [id], onDelete: SetNull)
  children          Category[]  @relation("CategoryToCategory")
  products          Product[]
  coupons           Coupon[]
}

model Product {
  id                String              @id @default(cuid())
  name              String
  slug              String              @unique
  description       String?
  shortDescription  String?
  brand             String?
  externalId        String?
  sku               String?
  ean               String?
  categoryId        String?
  marketplaceId     String?
  mainImage         String?
  rating            Decimal?            @db.Decimal(3, 2)
  reviewCount       Int                 @default(0)
  status            ProductStatus       @default(DRAFT)
  featured          Boolean             @default(false)
  dailyOffer        Boolean             @default(false)
  gerraydChoice     Boolean             @default(false)
  highlightLabel    String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  lastSyncedAt      DateTime?
  category          Category?           @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  marketplace       Marketplace?        @relation(fields: [marketplaceId], references: [id], onDelete: SetNull)
  images            ProductImage[]
  offers            ProductOffer[]
  favorites         Favorite[]
  priceAlerts       PriceAlert[]
  clicks            Click[]

  @@unique([marketplaceId, externalId])
  @@unique([marketplaceId, sku])
  @@unique([marketplaceId, ean])
}

model ProductImage {
  id                String   @id @default(cuid())
  productId         String
  url               String
  altText           String?
  sortOrder         Int      @default(0)
  createdAt         DateTime @default(now())
  product           Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductOffer {
  id                  String                @id @default(cuid())
  productId           String
  marketplaceId       String
  currentPrice        Decimal               @db.Decimal(10, 2)
  oldPrice            Decimal?              @db.Decimal(10, 2)
  discountPercentage  Decimal?              @db.Decimal(5, 2)
  installmentCount    Int?
  installmentValue    Decimal?              @db.Decimal(10, 2)
  pixPrice            Decimal?              @db.Decimal(10, 2)
  available           Boolean               @default(true)
  shippingInformation String?
  originalUrl         String
  affiliateUrl        String
  validUntil          DateTime?
  lastCheckedAt       DateTime?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  product             Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  marketplace         Marketplace           @relation(fields: [marketplaceId], references: [id], onDelete: Cascade)
  priceHistory        ProductPriceHistory[]
  affiliateLinks      AffiliateLink[]
  clicks              Click[]
}

model ProductPriceHistory {
  id                  String       @id @default(cuid())
  productOfferId      String
  price               Decimal      @db.Decimal(10, 2)
  oldPrice            Decimal?     @db.Decimal(10, 2)
  discountPercentage  Decimal?     @db.Decimal(5, 2)
  recordedAt          DateTime     @default(now())
  productOffer        ProductOffer @relation(fields: [productOfferId], references: [id], onDelete: Cascade)
}

model AffiliateLink {
  id                  String       @id @default(cuid())
  productOfferId      String
  originalUrl         String
  affiliateUrl        String
  valid               Boolean      @default(true)
  lastValidatedAt     DateTime?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  productOffer        ProductOffer @relation(fields: [productOfferId], references: [id], onDelete: Cascade)
}

model Coupon {
  id                  String       @id @default(cuid())
  marketplaceId       String
  categoryId          String?
  title               String
  code                String?
  description         String
  rules               String?
  discountValue       String?
  freeShipping        Boolean      @default(false)
  usageCount          Int          @default(0)
  status              CouponStatus @default(ACTIVE)
  validUntil          DateTime?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  marketplace         Marketplace  @relation(fields: [marketplaceId], references: [id], onDelete: Cascade)
  category            Category?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
}

model Banner {
  id                  String         @id @default(cuid())
  title               String
  subtitle            String?
  imageUrl            String?
  targetUrl           String?
  position            BannerPosition
  startsAt            DateTime?
  endsAt              DateTime?
  active              Boolean        @default(true)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
}

model Favorite {
  id                  String   @id @default(cuid())
  userId              String?
  productId           String
  browserKey          String?
  createdAt           DateTime @default(now())
  user                User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product             Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@unique([browserKey, productId])
}

model PriceAlert {
  id                  String   @id @default(cuid())
  userId              String
  productId           String
  targetPrice         Decimal  @db.Decimal(10, 2)
  active              Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product             Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Click {
  id                  String      @id @default(cuid())
  productId           String
  offerId             String
  marketplaceId       String
  userId              String?
  sessionId           String?
  ipHash              String?
  userAgent           String?
  referrer            String?
  createdAt           DateTime    @default(now())
  product             Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  offer               ProductOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)
  marketplace         Marketplace @relation(fields: [marketplaceId], references: [id], onDelete: Cascade)
  user                User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model SearchLog {
  id                  String   @id @default(cuid())
  userId              String?
  term                String
  resultCount         Int      @default(0)
  createdAt           DateTime @default(now())
  user                User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model ImportJob {
  id                  String          @id @default(cuid())
  adminUserId         String?
  marketplaceId       String?
  sourceUrl           String?
  query               String?
  payload             Json?
  status              ImportJobStatus @default(PENDING)
  previewData         Json?
  errorMessage        String?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  adminUser           AdminUser?      @relation(fields: [adminUserId], references: [id], onDelete: SetNull)
  marketplace         Marketplace?    @relation(fields: [marketplaceId], references: [id], onDelete: SetNull)
}

model SyncJob {
  id                  String        @id @default(cuid())
  adminUserId         String?
  marketplaceId       String?
  scope               String
  status              SyncJobStatus @default(PENDING)
  startedAt           DateTime?
  finishedAt          DateTime?
  processedCount      Int           @default(0)
  failedCount         Int           @default(0)
  metadata            Json?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  adminUser           AdminUser?    @relation(fields: [adminUserId], references: [id], onDelete: SetNull)
  marketplace         Marketplace?  @relation(fields: [marketplaceId], references: [id], onDelete: SetNull)
}

model IntegrationLog {
  id                  String              @id @default(cuid())
  marketplaceId       String?
  level               IntegrationLogLevel
  operation           String
  message             String
  metadata            Json?
  createdAt           DateTime            @default(now())
  marketplace         Marketplace?        @relation(fields: [marketplaceId], references: [id], onDelete: SetNull)
}
